{
  "name": "smartclips",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "vscode",
  // FUSE inside the dev container, for running `smartclips mount` by hand.
  "runArgs": [
    "--cap-add=SYS_ADMIN",
    "--device=/dev/fuse",
    "--security-opt=apparmor=unconfined"
  ],
  "postCreateCommand": "go mod download",
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.go",
        "editorconfig.editorconfig"
      ],
      "settings": {
        "go.lintTool": "golangci-lint",
        "go.lintOnSave": "workspace",
        "editor.formatOnSave": true
      }
    }
  }
}
